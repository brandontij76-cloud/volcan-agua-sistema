# Copia este archivo como ".env" y completa con los datos de TU proyecto de Firebase.
# Los obtienes en: Firebase Console > Configuracion del proyecto > Cuentas de servicio > Generar nueva clave privada
# Eso descarga un JSON. De ese JSON copias los siguientes 3 valores:

FIREBASE_PROJECT_ID=tu-proyecto-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nAAAA...\n-----END PRIVATE KEY-----\n"

# URL de la base de datos en tiempo real (Realtime Database), la ves en Firebase Console > Realtime Database
FIREBASE_DATABASE_URL=https://tu-proyecto-id-default-rtdb.firebaseio.com

# Puerto donde correra el servidor local
PORT=3000

# Clave simple para proteger el panel administrativo (cambiala)
ADMIN_PASSWORD=admin123
