# Copia este archivo a .env y completa cada valor (o corre generar-env.js,
# que arma la mayoria de esto automaticamente a partir del .json de Firebase).
# NUNCA subas el archivo .env real a git -- ya esta en .gitignore.

# --- Firebase (Cuentas de servicio > Generar clave privada nueva) ---
FIREBASE_PROJECT_ID=el project_id del json
FIREBASE_CLIENT_EMAIL=el client_email del json
FIREBASE_PRIVATE_KEY="el private_key del json, tal cual, entre comillas"
FIREBASE_DATABASE_URL=la URL de tu Realtime Database

# --- Servidor ---
PORT=3000

# --- Panel administrativo ---
# Usa una contraseña larga y unica, no una que ya uses en otro lado.
ADMIN_PASSWORD=la contrasena que quieras para el panel administrativo

# Clave para firmar los tokens de sesion (panel admin y colaboradores).
# Generala una sola vez con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# y no la compartas ni la subas a git.
SESSION_SECRET=una-cadena-larga-y-aleatoria-distinta-al-admin-password

# Dominio(s) desde donde se puede usar la API (separados por coma si hay
# mas de uno). En Render, pon la URL real de tu sitio, por ejemplo:
# https://volcan-agua-sistema.onrender.com
CORS_ORIGIN=http://localhost:3000

# --- Asistente con IA (opcional, gratis en https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=tu-llave-aqui
GEMINI_MODEL=gemini-flash-latest
